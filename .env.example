# Sample environment configuration for the Spark repo
# PostgreSQL settings (used by Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=spark
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/spark

# Redis settings
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka settings
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# JWT secret (for API auth)
JWT_SECRET=super-secret-key

# Optional: disable SHAP for faster inference (set to 1 to disable)
DISABLE_SHAP=0

# Add any additional custom variables here
